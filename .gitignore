# ============================================
# Spatial Python Course - .gitignore
# NOTE: data/ is intentionally NOT ignored.
# Sample datasets (DEM, Sentinel image, shapefiles,
# and generated outputs) are meant to be tracked
# in this repository so students can follow along.
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Jupyter / Notebooks ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Quarto build artifacts ---
/.quarto/
_site/
docs/
*_files/
*.html.orig

# --- Streamlit ---
.streamlit/secrets.toml

# --- Environment / secrets ---
.env
.env.local
*.key

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
*.log

# --- Temporary / scratch files ---
*.tmp
*.bak
~$*

# ============================================
# Explicitly keep course data tracked
# (these lines are just for clarity - nothing
# above ignores the data/ folder or its contents)
# ============================================
!data/
!data/**
